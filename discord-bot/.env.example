# Discord bot token from Discord Developer Portal
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# How many messages of channel history to read for context (default: 20)
HISTORY_LIMIT=20

# GitHub Personal Access Token — fine-grained, Contents: Read on cc404ssis/TRINITYBRAIN
# Without this, bot falls back to static PROJECT_CONTEXT in bot.py
TRINITYBRAIN_GITHUB_TOKEN=your_github_pat_with_repo_read_scope
